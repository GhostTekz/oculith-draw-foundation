{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oculith Draw Foundation",
  "version": "2026.67.0",
  "identifier": "com.ghosttekz.ocudraw.community",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3041",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Oculith Draw Foundation",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "backgroundColor": "#0b0b0c",
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "community-icons/32x32.png",
      "community-icons/128x128.png",
      "community-icons/128x128@2x.png",
      "community-icons/icon.icns",
      "community-icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "cups-bsd",
          "cups-client"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    },
    "resources": {
      "../../LICENSE.md": "notices/Oculith-Draw-LICENSE.md",
      "package-notices": "notices/third-party",
      "pdfium-extract/LICENSE": "notices/pdfium/LICENSE",
      "pdfium-extract/licenses": "notices/pdfium/licenses",
      "binaries/linux-x64/LICENSE": "notices/pdfium/linux-x64/LICENSE",
      "binaries/win-x64/LICENSE": "notices/pdfium/win-x64/LICENSE",
      "binaries/win-arm64/LICENSE": "notices/pdfium/win-arm64/LICENSE",
      "../public/pdfjs/LICENSE": "notices/pdfjs/LICENSE",
      "../public/pdfjs/web/cmaps/LICENSE": "notices/pdfjs/cmaps/LICENSE",
      "../public/pdfjs/web/standard_fonts/LICENSE_FOXIT": "notices/pdfjs/standard_fonts/LICENSE_FOXIT",
      "../public/pdfjs/web/standard_fonts/LICENSE_LIBERATION": "notices/pdfjs/standard_fonts/LICENSE_LIBERATION",
      "../public/fonts/OFL-Geist.txt": "notices/fonts/OFL-Geist.txt",
      "../public/fonts/OFL-InstrumentSerif.txt": "notices/fonts/OFL-InstrumentSerif.txt",
      "resources/kaders": "kaders",
      "resources/tessdata": "tessdata",
      "resources/fonts": "fonts",
      "community-icons/icon.ico": "file-icon.ico"
    },
    "externalBin": [
      "binaries/ocudraw-community-pdfium-worker"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "OcuDrawCommunity.pdf",
        "description": "Portable Document Format",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "ocudraw-community"
        ]
      }
    }
  },
  "mainBinaryName": "ocudraw-community"
}
