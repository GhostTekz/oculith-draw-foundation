{
  "$schema": "https://schemas.tauri.app/config/2",
  "identifier": "thumbnail-view",
  "description": "Minimal event and window controls for the separate thumbnail view",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["thumbnail-*"],
  "permissions": [
    "core:event:default",
    "core:window:allow-get-all-windows",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
