{
  "$schema": "https://schemas.tauri.app/config/2",
  "identifier": "mobile",
  "description": "Capabilities for mobile platforms (Android/iOS)",
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "shell:allow-open",
    "os:default",
    "process:allow-restart",
    "process:allow-exit",
    "deep-link:default"
  ]
}
