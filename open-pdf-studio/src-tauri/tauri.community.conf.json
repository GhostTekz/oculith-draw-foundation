{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oculith Draw Foundation",
  "mainBinaryName": "ocudraw-community",
  "identifier": "com.ghosttekz.ocudraw.community",
  "app": {
    "windows": [
      {
        "title": "Oculith Draw Foundation",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "backgroundColor": "#0b0b0c",
        "devtools": true
      }
    ]
  },
  "bundle": {
    "externalBin": ["binaries/ocudraw-community-pdfium-worker"],
    "resources": {
      "../public/foundation-source.json": "source/foundation-source.json"
    },
    "linux": { "deb": { "desktopTemplate": null } },
    "icon": [
      "community-icons/32x32.png",
      "community-icons/128x128.png",
      "community-icons/128x128@2x.png",
      "community-icons/icon.icns",
      "community-icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "OcuDrawCommunity.pdf",
        "description": "Portable Document Format",
        "role": "Editor"
      },
      {
        "ext": ["ocaddon"],
        "name": "OcuDrawCommunity.addon",
        "description": "Oculith Draw add-on file",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ocudraw-community", "oculithdraw"]
      }
    }
  }
}
