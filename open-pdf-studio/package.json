{
  "name": "ocudraw-community",
  "version": "2026.68.0",
  "description": "Oculith Draw Foundation, an open source PDF workspace",
  "scripts": {
    "prepare:native-runtime": "node scripts/native-runtime.mjs",
    "prepare:ocr-runtime": "node scripts/ocr-runtime.mjs",
    "predev": "npm run prepare:native-runtime && npm run prepare:ocr-runtime && cargo build -p pdfium-worker",
    "dev": "vite",
    "prebuild": "npm run prepare:native-runtime && npm run prepare:ocr-runtime && cargo build --release -p pdfium-worker",
    "build": "vite build",
    "build:community": "node scripts/build-community.mjs --frontend-only",
    "build:web-unit": "vite build --config vite.web-unit.config.js",
    "dev:web-unit": "vite --config vite.web-unit.config.js --port 3079 --strictPort",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:debug": "node scripts/run-dev-debug.mjs",
    "tauri:community": "node scripts/build-community.mjs",
    "bump": "node scripts/bump-version.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/draai-unit-tests.mjs",
    "smoke:native": "node scripts/run-native-markup-smoke.mjs",
    "smoke:community-offline": "node scripts/community-offline-smoke.mjs",
    "test:web-unit": "node web-unit/demo-e2e.mjs",
    "test:quality": "node --test scripts/native-runtime.test.mjs scripts/package-notices.test.mjs scripts/square-image-annotation.test.mjs scripts/build-community.test.mjs scripts/pdf-extension-preservation.test.mjs scripts/addon-manager.test.mjs scripts/pack-addon.test.mjs js/editions/compose-addons.test.mjs",
    "tauri:build": "node scripts/build-community.mjs"
  },
  "keywords": [
    "tauri",
    "pdf",
    "editor",
    "annotator",
    "viewer",
    "open-source"
  ],
  "author": "GhostTekz (based on Open PDF Studio by OpenAEC Foundation)",
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "playwright": "^1.59.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@embedpdf/pdfium": "2.15.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "~2.11",
    "@tauri-apps/plugin-dialog": "~2.7",
    "@tauri-apps/plugin-fs": "~2.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "solid-js": "^1.9.11"
  }
}
